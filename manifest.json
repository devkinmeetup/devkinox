{
  "manifest_version": 3,
  "name": "Devkinox",
  "version": "1.3.0.0",
  "description": "kintone開発者向けツール集",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.cybozu.com/*"],
  "action": {
    "default_popup": "core/main.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.cybozu.com/*"],
      "js": ["addons/toggleAppDescription.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
